+fn mulpd_inline(ctx: &mut JitContext, src: u32, r: u32) {
+    let dst = global_pointers::get_reg_xmm_offset(r);
+    // Retain the existing helper for every non-finite operand. NaN payload
+    // selection is not preserved by merely repeating the Rust operand order.
+    for (i, address) in [src + 4, src + 12, dst + 4, dst + 12].iter().enumerate() {
+        ctx.builder.load_fixed_i32(*address);
+        ctx.builder.const_i32(0x7ff00000);
+        ctx.builder.and_i32();
+        ctx.builder.const_i32(0x7ff00000);
+        ctx.builder.eq_i32();
+        if i != 0 { ctx.builder.or_i32(); }
+    }
+    ctx.builder.if_void();
+    let scratch = global_pointers::sse_scratch_register as u32;
+    if src != scratch {
+        // Same by-value copy as sse_read128_xmm_xmm, safe even for aliases.
+        for lane in [0, 8] {
+            ctx.builder.const_i32((scratch + lane) as i32);
+            ctx.builder.const_i32((src + lane) as i32);
+            ctx.builder.load_aligned_i64(0);
+            ctx.builder.store_aligned_i64(0);
+        }
+    }
+    ctx.builder.const_i32(scratch as i32);
+    ctx.builder.const_i32(r as i32);
+    ctx.builder.call_fn2("instr_660F59");
+    ctx.builder.else_();
+    // Match the helper's source * destination operand order. Each lane reads
+    // both operands before its store, including the r1 == r2 case.
+    for lane in [0, 8] {
+        ctx.builder.const_i32((dst + lane) as i32);
+        ctx.builder.const_i32((src + lane) as i32);
+        ctx.builder.load_aligned_f64(0);
+        ctx.builder.const_i32((dst + lane) as i32);
+        ctx.builder.load_aligned_f64(0);
+        ctx.builder.mul_f64();
+        ctx.builder.store_aligned_f64(0);
+    }
+    ctx.builder.block_end();
+}
