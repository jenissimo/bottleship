// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`D3D9 PS3 I/O (W6) vPos/vFace/oDepth generate distinct PS input/output builtins 1`] = `
"@fragment
fn fs_main(in: PsInput) -> PsOutput {
    var r0: vec4<f32> = vec4<f32>(0.0);
    var oC0: vec4<f32> = vec4<f32>(0.0);
    var oDepth: f32 = 0.0;
    
    // add
    let _st0 = (vec4<f32>((in.pos).xy - vec2<f32>(0.5), (in.pos).zw) + select(vec4<f32>(-1.0), vec4<f32>(1.0), in.frontFacing));
    r0.x = _st0.x;
    r0.y = _st0.y;
    r0.z = _st0.z;
    r0.w = _st0.w;
    // mov
    let _st1 = r0;
    oC0.x = _st1.x;
    oC0.y = _st1.y;
    oC0.z = _st1.z;
    oC0.w = _st1.w;
    oDepth = min(max((r0).x, 0.0), 1.0);
    
    var out: PsOutput;
    out.color = oC0;
    out.depth = oDepth;
    return out;
}"
`;
